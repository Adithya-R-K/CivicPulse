              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "geojson"]
            }
          }
        },
        {
          "name": "Preview AI Prediction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Live electric wire falling across street\",\n  \"description\": \"High voltage transformer wire snapped and fell across the road near residential school\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/analytics/predict",
