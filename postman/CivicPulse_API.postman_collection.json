{
  "info": {
    "name": "CivicPulse REST API Collection",
    "_postman_id": "c1v1c-pu1s3-m3rn-2026-api",
    "description": "Complete Postman Collection for CivicPulse MERN Stack REST API endpoints with JWT Authentication, Complaints CRUD, AI prediction, and Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "complaint_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Citizen",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\",\n  \"fullName\": \"John Doe\",\n  \"address\": \"123 Park Street, Coimbatore\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login Citizen (Auto Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token saved:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"citizen\",\n  \"password\": \"Citizen123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Complaints",
      "item": [
        {
          "name": "List All Complaints",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/complaints",
              "host": ["{{base_url}}"],
              "path": ["api", "complaints"]
            }
          }
        },
        {
          "name": "Filter Complaints by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/complaints?category=Roads",
              "host": ["{{base_url}}"],
              "path": ["api", "complaints"],
              "query": [
                { "key": "category", "value": "Roads" }
              ]
            }
          }
        },
        {
          "name": "Create Complaint (AI Categorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.complaint && jsonData.complaint._id) {",
                  "    pm.collectionVariables.set('complaint_id', jsonData.complaint._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Urgent drinking water pipe broken near station\",\n  \"description\": \"Clean water is gushing out of an underground pipeline near the railway station road.\",\n  \"location\": \"Coimbatore Railway Junction\",\n  \"latitude\": 11.0005,\n  \"longitude\": 76.9654\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/complaints",
              "host": ["{{base_url}}"],
              "path": ["api", "complaints"]
            }
          }
        },
        {
          "name": "Get Complaint by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/complaints/{{complaint_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "complaints", "{{complaint_id}}"]
            }
          }
        },
        {
          "name": "Toggle Upvote",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/complaints/{{complaint_id}}/upvote",
              "host": ["{{base_url}}"],
              "path": ["api", "complaints", "{{complaint_id}}", "upvote"]
            }
          }
        },
        {
          "name": "Add Discussion Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Municipal crew was spotted inspecting the spot this morning.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/complaints/{{complaint_id}}/comments",
              "host": ["{{base_url}}"],
              "path": ["api", "complaints", "{{complaint_id}}", "comments"]
            }
          }
        },
        {
          "name": "Admin Update Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\",\n  \"department\": \"Water & Sewage\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/complaints/{{complaint_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "complaints", "{{complaint_id}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics & AI",
      "item": [
        {
          "name": "Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/analytics/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics", "stats"]
            }
