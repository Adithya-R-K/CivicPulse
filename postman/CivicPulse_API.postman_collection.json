{
  "info": {
    "name": "CivicPulse Microservices API Collection",
    "_postman_id": "civicpulse-microservices-v2-collection",
    "description": "Comprehensive Postman Collection for CivicPulse Microservices Architecture: Civic Core Service (Node/Express/MongoDB) and Civic Intelligence Service (Python/Flask/SQLite).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "core_base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "intelligence_base_url", "value": "http://localhost:5001", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "complaint_id", "value": "660e1d0f5e71826b52a12301", "type": "string" },
    { "key": "analysis_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Civic Core Service (Node.js/Express)",
      "item": [
        {
          "name": "Health Check (Core Service)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{core_base_url}}/api/v1/health" }
          }
        },
        {
          "name": "Auth - Register Citizen",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"citizen_demo\",\n  \"email\": \"citizen_demo@civicpulse.gov\",\n  \"password\": \"Citizen123\",\n  \"fullName\": \"Coimbatore Citizen\",\n  \"address\": \"Gandhipuram, Coimbatore\",\n  \"phone\": \"9876500001\"\n}"
            },
            "url": { "raw": "{{core_base_url}}/api/v1/auth/register" }
          }
        },
        {
          "name": "Auth - Login Citizen",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"citizen\",\n  \"password\": \"Citizen123\"\n}"
            },
            "url": { "raw": "{{core_base_url}}/api/v1/auth/login" }
          }
        },
        {
          "name": "Auth - Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('admin_token', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123\"\n}"
            },
            "url": { "raw": "{{core_base_url}}/api/v1/auth/login" }
          }
        },
        {
          "name": "Auth - Get Current Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{core_base_url}}/api/v1/auth/me" }
          }
        },
        {
          "name": "Complaints - Submit with AI Analysis (Inter-Service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.complaint && json.complaint._id) pm.collectionVariables.set('complaint_id', json.complaint._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Major water pipeline burst on Avinashi Road\",\n  \"description\": \"Clean water is gushing out of broken municipal pipeline beside Peelamedu signal. Serious flooding hazard.\",\n  \"location\": \"Avinashi Road near Peelamedu\",\n  \"latitude\": 11.0280,\n  \"longitude\": 77.0043\n}"
            },
            "url": { "raw": "{{core_base_url}}/api/v1/complaints" }
          }
        },
        {
          "name": "Complaints - List All (With Pagination & Filters)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{core_base_url}}/api/v1/complaints?limit=10&page=1" }
          }
        },
        {
          "name": "Complaints - Get By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{core_base_url}}/api/v1/complaints/{{complaint_id}}" }
          }
        },
        {
          "name": "Complaints - Update Details (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": \"Avinashi Road near Peelamedu Flyover, Coimbatore\"\n}"
            },
            "url": { "raw": "{{core_base_url}}/api/v1/complaints/{{complaint_id}}" }
          }
        },
        {
          "name": "Complaints - Update Status (PATCH Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\"\n}"
            },
            "url": { "raw": "{{core_base_url}}/api/v1/complaints/{{complaint_id}}/status" }
          }
        },
        {
          "name": "Complaints - Upvote",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{core_base_url}}/api/v1/complaints/{{complaint_id}}/upvote" }
          }
        },
        {
          "name": "Complaints - Add Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"comment\": \"Municipal ward team has arrived at the location to isolate valve.\"\n}"
            },
            "url": { "raw": "{{core_base_url}}/api/v1/complaints/{{complaint_id}}/comments" }
          }
        },
        {
          "name": "Analytics - Integrated Summary (Core + Intelligence)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{core_base_url}}/api/v1/analytics/summary" }
          }
        },
        {
          "name": "Analytics - Department List",
          "request": {
            "method": "GET",
            "url": { "raw": "{{core_base_url}}/api/v1/departments" }
          }
        }
      ]
    },
    {
      "name": "2. Civic Intelligence Service (Python/Flask)",
      "item": [
        {
          "name": "Health Check (Intelligence Service)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{intelligence_base_url}}/api/v1/health" }
          }
        },
        {
          "name": "AI - Full Analyze & Persist to SQLite",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.analysis_id) pm.collectionVariables.set('analysis_id', json.analysis_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Live electric wire snapping near school - URGENT\",\n  \"description\": \"High tension electric wire has snapped and sparking on the ground. Immediate hazard.\"\n}"
            },
            "url": { "raw": "{{intelligence_base_url}}/api/v1/analyze" }
          }
        },
        {
          "name": "AI - Classify Category Only",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Potholes on Cross Cut Road\",\n  \"description\": \"Deep crater-like potholes damaging car tires and causing traffic blocks.\"\n}"
            },
            "url": { "raw": "{{intelligence_base_url}}/api/v1/classify" }
          }
        },
        {
          "name": "AI - Predict Priority",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fire in commercial garbage dumpster\",\n  \"description\": \"Dense smoke and flames rising from dumpster next to petrol pump - EMERGENCY!\",\n  \"category\": \"Safety\"\n}"
            },
            "url": { "raw": "{{intelligence_base_url}}/api/v1/predict-priority" }
          }
        },
        {
          "name": "AI - Detect Spam",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"CLAIM FREE CRYPTO AIRDROP NOW\",\n  \"description\": \"Click http://free-airdrop.xyz to claim $500 lottery jackpot right now!\"\n}"
            },
            "url": { "raw": "{{intelligence_base_url}}/api/v1/detect-spam" }
          }
        },
        {
          "name": "AI - Similarity Detection",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Pothole on Avinashi Road near Peelamedu\",\n  \"description\": \"Severe potholes near Peelamedu bus stop causing traffic jams.\",\n  \"existing_complaints\": [\n    {\n      \"id\": \"comp_001\",\n      \"title\": \"Deep pothole on Avinashi Road\",\n      \"description\": \"Large potholes on Avinashi Road near Peelamedu causing vehicle damage.\",\n      \"category\": \"Roads\",\n      \"status\": \"Submitted\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{intelligence_base_url}}/api/v1/similar-complaints" }
          }
        },
        {
          "name": "AI - Analytics Summary from SQLite",
          "request": {
            "method": "GET",
            "url": { "raw": "{{intelligence_base_url}}/api/v1/analytics/summary" }
          }
        },
        {
          "name": "SQLite CRUD - List Analysis History",
          "request": {
            "method": "GET",
            "url": { "raw": "{{intelligence_base_url}}/api/v1/history?limit=10" }
          }
        },
        {
          "name": "SQLite CRUD - Get Analysis By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{intelligence_base_url}}/api/v1/history/{{analysis_id}}" }
          }
        },
        {
          "name": "SQLite CRUD - Create Manual Record",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Overflowing garbage dumpster\",\n  \"description\": \"Bin overflowing for four days near market.\",\n  \"category\": \"Waste\"\n}"
            },
            "url": { "raw": "{{intelligence_base_url}}/api/v1/history" }
          }
        },
        {
          "name": "SQLite CRUD - Update Analysis Record (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"Urgent\",\n  \"is_spam\": false\n}"
            },
            "url": { "raw": "{{intelligence_base_url}}/api/v1/history/{{analysis_id}}" }
          }
        },
        {
          "name": "SQLite CRUD - Delete Analysis Record (DELETE)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{intelligence_base_url}}/api/v1/history/{{analysis_id}}" }
          }
        }
      ]
    }
  ]
}
